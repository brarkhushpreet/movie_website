{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khushpreet-movies",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "khushpreet-movies" }
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }
  ],
  "vars": {
    "DEPLOYMENT_TARGET": "cloudflare"
  },
  "routes": [
    { "pattern": "movies.khushpreet.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
