{
  "name": "movie-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "node scripts/check-build-env.mjs && opennextjs-cloudflare build",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev --config release/wrangler.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.132.0"
  }
}
